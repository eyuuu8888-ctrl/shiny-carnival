# ==========================================================
# 微信自动回复 Bot 配置
# 复制此文件为 config.yaml 后修改
# ==========================================================

bot:
  # 机器人人设 (System Prompt)
  # 你希望 AI 用什么风格、身份来回复
  system_prompt: |
    你是我的微信小助手，性格友好、回复简洁自然，像真人一样聊天。
    - 回复要简短，一般不超过 2 句话。
    - 不要使用 Markdown 格式 (不要 ** 或 #)。
    - 保持口语化，必要时可以用 emoji。
    - 如果遇到你不确定的事情，就说"这个我不太清楚，等他回来问问他"。

  # 对话记忆轮数 (保留最近 N 轮对话作为上下文)
  memory_rounds: 10

  # 回复前的延迟(秒)，模拟真人打字，建议 1-5 秒
  reply_delay_min: 1
  reply_delay_max: 4

  # 是否显示正在输入状态 (通过短暂延迟模拟)
  simulate_typing: true

listen:
  # 需要监听并自动回复的联系人/群昵称列表
  # 必须是微信里显示的昵称或备注名
  # 留空则不监听任何人（安全默认值）
  contacts:
    - "文件传输助手"
    # - "张三"
    # - "某某某群"

  # 群聊中是否只在被 @ 时才回复
  group_reply_only_at_me: true

filter:
  # 忽略这些关键词开头的消息（不触发自动回复）
  ignore_prefixes:
    - "#"     # 以 # 开头的消息不回（方便自己手动发消息不被接管）
    - "/"

  # 忽略非文本类型的消息 (图片/语音/视频/文件 不回复)
  ignore_non_text: true
