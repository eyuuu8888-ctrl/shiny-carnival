    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@linuxdo-summary/core": "workspace:*",
    "@linuxdo-summary/ui": "workspace:*",
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "typescript": "^5.6.3",
    "wxt": "^0.19.13"
  }
}
